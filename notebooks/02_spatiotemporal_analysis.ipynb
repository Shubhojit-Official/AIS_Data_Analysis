   "source": [
    "monthly_cell = ais.groupby([\"year\",\"month\",\"cell_ll_lat\",\"cell_ll_lon\"], as_index=False).agg(total_hours=(\"hours\",\"sum\"), fishing_hours=(\"fishing_hours\",\"sum\"), active_vessels=(\"mmsi\",\"nunique\"), active_days=(\"date\",\"nunique\"))\n",
    "print(\"Aggregated shape:\", monthly_cell.shape)\n",
    "display(monthly_cell.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a2064551",
   "metadata": {},
   "source": [
    "### 4. Supplementary fishing ratio"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "eadfc35f",
   "metadata": {},
   "outputs": [
