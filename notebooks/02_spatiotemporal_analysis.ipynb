   ],
   "source": [
    "monthly_cell[\"fishing_ratio\"] = np.where(monthly_cell.total_hours > 0, monthly_cell.fishing_hours/monthly_cell.total_hours, np.nan)\n",
    "display(monthly_cell.fishing_ratio.describe())\n",
    "ratio_one = int((monthly_cell.fishing_ratio == 1).sum())\n",
    "print(\"Ratio exactly 1:\", ratio_one)\n",
    "print(\"Percentage:\", round(100*ratio_one/len(monthly_cell),2), \"%\")\n",
    "print(\"Groups where fishing_hours > total_hours:\", int((monthly_cell.fishing_hours > monthly_cell.total_hours).sum()))"
   ]
  },
